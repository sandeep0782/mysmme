# See https://git-scm.com/docs/gitignore for more about ignoring files.

# =========================
# Dependencies
# =========================
node_modules/
**/node_modules/

.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# =========================
# Next.js
# =========================
.next/
out/

# =========================
# Production / Build
# =========================
build/

# =========================
# Testing
# =========================
coverage/

# =========================
# Environment files
# =========================
.env
.env.*
!.env.example

# =========================
# Vercel
# =========================
.vercel/

# =========================
# TypeScript
# =========================
*.tsbuildinfo
next-env.d.ts

# =========================
# macOS / Editors
# =========================
.DS_Store
*.pem
.vscode/
.idea/

# =========================
# Logs / Debug
# =========================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Debug images
debug-original.jpg
debug-transformed.jpg
**/debug-original.jpg
**/debug-transformed.jpg

# =========================
# Server uploads
# =========================
server/uploads/
server/uploads/**

# =========================
# Server generated / local files
# =========================
server/node_modules/
server/.next/
server/dist/
server/build/

# =========================
# Local ML / generated files
# =========================
server/**/*.node
server/**/*.dylib
